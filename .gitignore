!data/conferences/xagi2026/
data/conferences/xagi2026/pdfs/
logs/
# Scratch area: keep hand-made backups, never the ad-hoc logs / dumps.
tmp/*
!tmp/backfill_backup/
tmp_sess*.json
backups/
*.egg-info/
dist/
build/
