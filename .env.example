# Copy to .env and fill in. .env is gitignored.
SJTU_API_BASE=https://models.sjtu.edu.cn/api/v1
SJTU_API_KEY=sk-replace-me

# ─── Model configuration ──────────────────────────────────────────────
# One place to switch models globally. The real master switches are
# DAILY_MODEL and DEEP_READ_MODEL; everything else cascades from them by
# default (the fallback is noted in parentheses). When glm-5.1 is down,
# just change DAILY_MODEL and journals/synthesis/talk-overview follow.
#
# Light tasks (scoring, summaries, overviews) — daily + most modules
DAILY_MODEL=deepseek-chat
# Deep reads (long-form close reading) — daily / manual queue
DEEP_READ_MODEL=deepseek-reasoner
#
# Leave the rest empty to inherit the master switches above. Set one only
# to pin a specific model for that task type.
# JOURNALS_MODEL=          # journals      (empty → DAILY_MODEL)
# SYNTHESIS_MODEL=         # synthesis      (empty → DAILY_MODEL)
# TALK_OVERVIEW_MODEL=     # talk overviews (empty → DAILY_MODEL)
# TALK_MODEL=              # talk deep read (empty → DEEP_READ_MODEL)
#
# Client-level defaults: used when a caller doesn't pass an explicit model
# (most callers do, so you rarely touch these; shootout / smoke_test hit them).
SJTU_MODEL_FAST=deepseek-chat
SJTU_MODEL_DEEP=deepseek-reasoner
# ──────────────────────────────────────────────────────────────────────

# LLM request timeout (seconds) and max attempts. The endpoint sometimes hangs
# on long deep-read calls; defaults abandon a stuck request after 5 min and try
# at most 3 times (worst case ~15 min/paper). Lower both to fail faster on flaky
# days; raise them if legitimate long deep reads get cut off mid-output.
# SJTU_TIMEOUT=300
# SJTU_MAX_ATTEMPTS=3

# arXiv is friendlier to identified clients — put your real contact email here.
# Helps avoid 403/429. (ARXIV_MIN_INTERVAL raises request spacing if still rate-limited.)
ARXIV_USER_AGENT=research-news/1.0 (mailto:you@example.com)
# ARXIV_MIN_INTERVAL=3
# ARXIV_FETCH_ATTEMPTS=4

# Semantic Scholar API key. S2 often declines key requests for private/personal
# use, so we mostly live on the unauthenticated shared pool (frequent 429s). If
# you ever get a key, set it here and the limit problem mostly goes away.
# SEMANTIC_SCHOLAR_API_KEY=
# Without a key, the lever is patient retry. Defaults: 6 attempts, jittered
# backoff up to 30s. Bump these on heavy-throttle days.
# S2_FETCH_ATTEMPTS=6
# S2_MAX_BACKOFF=30

# Deep read fetches the abstracts of the paper's key cited works (via Semantic
# Scholar) so the notes can survey the whole direction. On by default; set to 0
# to disable. Fails open (just skips the cited-works block) if S2 is unreachable.
# DEEP_READ_FETCH_REFS=0

# Institution green-light: papers with an author at a US News top-50 institution
# (config/institutions.yaml) are deep-read regardless of score. On by default;
# set to 0 to disable. Affiliations are looked up from OpenAlex at run time.
# AFFIL_GREENLIGHT=0
# Polite-pool contact for OpenAlex (faster, recommended). Your email.
# OPENALEX_MAILTO=you@example.com

# Manual deep-read queue: on the website (收藏 page) you can paste an arXiv link
# to queue a paper for deep-read; it's stored in your private state gist. The
# daily run reads that gist (research_news.manual_requests) and deep-reads each
# new link. Needs a classic PAT with the `gist` scope — the SAME token the
# publish-favorites job uses. Without it, the manual-queue step just skips.
# ⚠️ classic PAT 默认 90 天到期，过期后公开收藏快照 + 手动录入队列会一起失效
#    （详见 README「GIST_TOKEN 过期（周期性故障）」）。签发时 Expiration 请选
#    `No expiration`。自检：python -m research_news.gist_state
# GIST_TOKEN=ghp_replace-me
# Optional: pin the gist id (otherwise it's found by description / filename).
# RN_GIST_ID=
# Favorites you haven't deep-read yet are auto-backfilled (deep-read) by the
# daily run — star a paper in a report and it gets a deep read next time. Set to
# 0 to turn that off. MANUAL_FAV_LIMIT caps how many favorites to backfill per
# run (default 10) so a big backlog drains over several days, not one huge run.
# AUTO_DEEPREAD_FAVORITES=0
# MANUAL_FAV_LIMIT=10
