# Copy to .env and fill in. .env is gitignored.
SJTU_API_BASE=https://models.sjtu.edu.cn/api/v1
SJTU_API_KEY=sk-replace-me
SJTU_MODEL_FAST=deepseek-chat
SJTU_MODEL_DEEP=deepseek-reasoner

# Optional: Semantic Scholar API key (works without one but rate-limited)
# SEMANTIC_SCHOLAR_API_KEY=

# Deep read fetches the abstracts of the paper's key cited works (via Semantic
# Scholar) so the notes can survey the whole direction. On by default; set to 0
# to disable. Fails open (just skips the cited-works block) if S2 is unreachable.
# DEEP_READ_FETCH_REFS=0

# Institution green-light: papers with an author at a US News top-50 institution
# (config/institutions.yaml) are deep-read regardless of score. On by default;
# set to 0 to disable. Affiliations are looked up from OpenAlex at run time.
# AFFIL_GREENLIGHT=0
# Polite-pool contact for OpenAlex (faster, recommended). Your email.
# OPENALEX_MAILTO=you@example.com
