# Copy to .env and fill in. .env is gitignored.
SJTU_API_BASE=https://models.sjtu.edu.cn/api/v1
SJTU_API_KEY=sk-replace-me
SJTU_MODEL_FAST=deepseek-chat
SJTU_MODEL_DEEP=deepseek-reasoner

# Optional: Semantic Scholar API key (works without one but rate-limited)
# SEMANTIC_SCHOLAR_API_KEY=

# Optional: in the deep-read step, fetch the abstracts of the paper's key cited
# works (via Semantic Scholar) and feed them in so the notes can survey the
# whole direction, not just this one paper. Off by default; needs S2 reachable.
# DEEP_READ_FETCH_REFS=1
